#: core/Services/CalDAV/CalDAVClient.vala:683
msgid ""
"This server does not allow creating projects via CalDAV. Please create it "
"directly from your calendar provider's website."
msgstr ""
"Ta strežnik ne dovoljuje ustvarjanja projektov prek protokola CalDAV. "
"Projekt ustvarite neposredno na spletnem mestu svojega ponudnika koledarja."

#: core/Services/CalDAV/CalDAVClient.vala:738
msgid ""
"This server does not allow deleting projects via CalDAV. Please delete it "
"directly from your calendar provider's website."
msgstr ""
"Ta strežnik ne dovoljuje brisanja projektov prek protokola CalDAV. Projekt "
"izbrišite neposredno na spletnem mestu svojega ponudnika koledarja."

#: core/Services/CalDAV/CalDAVClient.vala:742
msgid ""
"This server does not support deleting projects via CalDAV. Please delete it "
"from the server directly."
msgstr ""
"Ta strežnik ne podpira brisanja projektov prek protokola CalDAV. Projekt "
"izbrišite neposredno na strežniku."

#: core/Services/CalDAV/CalDAVClient.vala:776
