diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6f9c616..5b238bf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -506,6 +506,15 @@ endif()
 # Use GNUInstallDirs
 
 include(GNUInstallDirs)
+
+if(DEFINED MESON_UNINSTALLED_PKGCONFIG_DIR)
+  string(REGEX REPLACE "^usr/" "" CMAKE_INSTALL_BINDIR "${CMAKE_INSTALL_BINDIR}")
+  string(REGEX REPLACE "^usr/" "" CMAKE_INSTALL_LIBDIR "${CMAKE_INSTALL_LIBDIR}")
+  string(REGEX REPLACE "^usr/" "" CMAKE_INSTALL_INCLUDEDIR "${CMAKE_INSTALL_INCLUDEDIR}")
+  string(REGEX REPLACE "^usr/" "" CMAKE_INSTALL_LIBEXECDIR "${CMAKE_INSTALL_LIBEXECDIR}")
+  string(REGEX REPLACE "^usr/" "" CMAKE_INSTALL_DATAROOTDIR "${CMAKE_INSTALL_DATAROOTDIR}")
+endif()
+
 set(BIN_INSTALL_DIR ${CMAKE_INSTALL_BINDIR} CACHE STRING "User executables directory name" FORCE)
 set(LIB_INSTALL_DIR ${CMAKE_INSTALL_LIBDIR} CACHE STRING "Library directory name" FORCE)
 set(INCLUDE_INSTALL_DIR ${CMAKE_INSTALL_INCLUDEDIR} CACHE STRING "Include directory name" FORCE)
@@ -685,6 +694,9 @@ if(LIBICAL_GLIB OR LIBICAL_BUILD_VZIC)
     )
   endif()
 
+  if(DEFINED MESON_UNINSTALLED_PKGCONFIG_DIR)
+    set(ENV{PKG_CONFIG_PATH} "${MESON_UNINSTALLED_PKGCONFIG_DIR}:$ENV{PKG_CONFIG_PATH}")
+  endif()
   pkg_search_module(
     GLIB
     glib-2.0>=${MIN_GLIB}
@@ -693,6 +705,13 @@ if(LIBICAL_GLIB OR LIBICAL_BUILD_VZIC)
     GOBJECT
     gobject-2.0>=${MIN_GLIB}
   )
+
+  if(DEFINED MESON_UNINSTALLED_PKGCONFIG_DIR)
+    foreach(_pkgconf_var GLIB_CFLAGS GOBJECT_CFLAGS GLIB_INCLUDE_DIRS GOBJECT_INCLUDE_DIRS)
+      string(REGEX REPLACE "-I?[^ ;]*/(pcre2-10\\.46|libffi-3\\.5\\.2|proxy-libintl-0\\.5)[^ ;]*" "" ${_pkgconf_var} "${${_pkgconf_var}}")
+      string(REGEX REPLACE "-I?[^ ;]*/glib-2\\.0/include[^ ;]*" "" ${_pkgconf_var} "${${_pkgconf_var}}")
+    endforeach()
+  endif()
   set_package_properties(
     GLIB
     PROPERTIES
